<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors (Fluent 2 / Clean Studio Glass) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F6F7FA"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#E2E5EC"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="SearchBoxBackground" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#D9DFEB"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E8F0"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F3F9"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#D0D6E5"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#ECEBFB"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EC"/>
    
    <!-- Accent palette -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#226366F1"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#EEF2FF"/>
    
    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#D1D5DB"/>

    <!-- Status & indicator colors -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessGlowBrush" Color="#3010B981"/>
    <SolidColorBrush x:Key="PinnedBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="FavoriteBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#0284C7"/>

    <!-- Type Icon Badges -->
    <SolidColorBrush x:Key="TypeIconTextBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="TypeIconBackgroundBrush" Color="#EEF2FF"/>

    <!-- Filter Bar Container -->
    <SolidColorBrush x:Key="FilterContainerBrush" Color="#E9ECF2"/>
    <SolidColorBrush x:Key="FilterPillHoverBrush" Color="#DFE3EC"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F0F2F6"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E2E5EC"/>

</ResourceDictionary>
