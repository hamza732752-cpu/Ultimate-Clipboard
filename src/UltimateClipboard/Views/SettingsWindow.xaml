<Window x:Class="UltimateClipboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Ultimate Clipboard"
        Width="520" Height="620"
        MinWidth="450" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Settings" 
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,16"/>

            <!-- Appearance Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" FontWeight="Medium"/>
                            <TextBlock Text="Choose dark or light visual style" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="140" SelectedValue="{Binding Theme, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- History & Storage Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="History &amp; Storage" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max History Entries" FontWeight="Medium"/>
                            <TextBlock Text="Maximum number of items preserved" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="100" Text="{Binding MaxHistoryEntries, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Retention (Days)" FontWeight="Medium"/>
                            <TextBlock Text="Auto-delete non-pinned items older than N days" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="100" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max Image Size (KB)" FontWeight="Medium"/>
                            <TextBlock Text="Skip images exceeding this threshold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="100" Text="{Binding MaxImageSizeKB, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Database Path" FontWeight="Medium"/>
                            <TextBlock Text="Location of the SQLite history file" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="180" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="Custom file path or leave default"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Privacy & Exclusions Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy &amp; Exclusions" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Process names to ignore (separated by semicolons, e.g. keepassxc;1password;bitwarden;mstsc):" 
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ExcludedApps, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,6" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock Text="Note: Application exclusion is best-effort based on foreground process detection." 
                               FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- AI & Image Search Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AI Image Search (On-Device)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox IsChecked="{Binding EnableAiImageRecognition}" Margin="0,4" 
                              Content="Enable on-device AI visual search for images and screenshots"/>
                    <TextBlock Text="When enabled, screenshots and images are analyzed locally using an embedded neural network (e.g. searching 'cat', 'car', 'screen' will find relevant images). Completely private with zero cloud calls." 
                               FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Updates Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Software Updates" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current Version" FontWeight="Medium"/>
                            <TextBlock Text="{Binding CurrentVersion, StringFormat='Version {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
                                Content="Check for Updates" 
                                Command="{Binding CheckForUpdatesCommand}"
                                Padding="14,6"
                                Cursor="Hand"/>
                    </Grid>

                    <CheckBox IsChecked="{Binding AutoCheckUpdates}" Margin="0,4,0,8" 
                              Content="Automatically check for updates on startup"/>

                    <!-- Update status notification -->
                    <TextBlock Text="{Binding UpdateStatus}" 
                               Foreground="{DynamicResource AccentBrush}" 
                               FontWeight="Medium" 
                               FontSize="12" 
                               Margin="0,4,0,4"
                               TextWrapping="Wrap"/>

                    <Button Content="Download Latest Release" 
                            Command="{Binding DownloadUpdateCommand}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                            Background="{DynamicResource SuccessBrush}" 
                            Foreground="White" 
                            BorderThickness="0"
                            Padding="14,6" 
                            HorizontalAlignment="Left" 
                            Margin="0,4,0,0"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Startup Behavior Section -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Startup Behavior" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <CheckBox IsChecked="{Binding StartMinimized}" Margin="0,4" Content="Start minimized to system tray"/>
                </StackPanel>
            </Border>

            <!-- Status & Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{DynamicResource AccentBrush}" 
                           VerticalAlignment="Center" 
                           Margin="0,0,16,0" 
                           FontWeight="Medium"/>
                <Button Content="Clear All History" 
                        Command="{Binding ClearHistoryCommand}"
                        Padding="12,6" Margin="0,0,8,0"
                        Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0"/>
                <Button Content="Reset Defaults" 
                        Command="{Binding ResetDefaultsCommand}"
                        Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Save" 
                        Command="{Binding SaveCommand}"
                        Padding="20,6" 
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
